# Mini-Linear — environment template (copy to .env locally; on Vercel set
# these in Project Settings → Environment Variables)

# ── Database (Neon PostgreSQL) ─────────────────────────────────────────────
# Runtime connection: use Neon's POOLED string (host contains "-pooler") so
# serverless functions reuse connections instead of exhausting Neon's limit.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# CLI-only connection (db push / migrate / seed): Neon's DIRECT, non-pooled
# string. Prisma reads it via `directUrl` in schema.prisma — migrations must
# not run through a transaction-mode pooler. The app itself never uses it.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Session secret ─────────────────────────────────────────────────────────
# Cookie signing secret. REQUIRED in production — generate a fresh one with:
#   openssl rand -hex 32
# Without it, every serverless instance mints its own secret and sessions
# break across invocations.
AUTH_SECRET=""

# ── Groq API key ───────────────────────────────────────────────────────────
# Powers the Issue Assistant and Workspace Copilot (https://api.groq.com).
# When absent, the app falls back to a deterministic mock so the UI stays
# usable without a model backend.
GROQ_API_KEY=""

# Optional Groq model override (default: llama-3.3-70b-versatile).
GROQ_MODEL=""

# ── Optional realtime socket ───────────────────────────────────────────────
# Browser realtime socket URL (inlined at build time). Leave unset on Vercel:
# the board automatically falls back to 15-second polling there.
NEXT_PUBLIC_REALTIME_URL=""
